<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns the runtime theme (Material You / AMOLED). This is just the
         launch/splash theme so there is no flash before Compose draws. -->
    <style name="Theme.RvxCompanion" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
